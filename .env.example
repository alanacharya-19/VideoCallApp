# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# See README.md for details.

# App ID issued by the video call provider
EXPO_PUBLIC_CALL_APP_ID=

# Short-lived token used for local development. Generate a fresh one per
# session from your provider dashboard — never reuse a production token here.
EXPO_PUBLIC_CALL_TEMP_TOKEN=
