# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# See README.md for details.

# Agora App ID — get yours from https://console.agora.io
EXPO_PUBLIC_AGORA_APP_ID=

# Agora temporary token for local development. Generate a fresh one per
# session from the Agora Console — never reuse a production token here.
# In production, mint tokens server-side and never ship them in the bundle.
EXPO_PUBLIC_AGORA_TOKEN=

# Legacy variable names (still supported)
EXPO_PUBLIC_CALL_APP_ID=
EXPO_PUBLIC_CALL_TEMP_TOKEN=
